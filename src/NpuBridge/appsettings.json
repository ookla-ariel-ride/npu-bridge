{
  // npu-bridge settings. Precedence: command line > NPU_BRIDGE_<NAME> environment variables > this file.
  // Put secrets (LafToken, LafAttestation) in appsettings.local.json or the environment, never here.

  "Backend": "phi-silica",
  "Listen": "http://127.0.0.1:5273",
  "QueueCapacity": 4,
  "ContextCacheSize": 4,
  "TruncateHistory": false,
  "SystemPromptPlacement": "auto",
  "ToolEmulation": true,
  "ToolSchema": "compact",
  "ContextWindowHint": 4096,
  "DrainWarningSeconds": 10,
  "ServiceName": "NpuBridge",
  "Verbose": false,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
